{
  "name": "mmu-lecture-management-api",
  "version": "1.0.0",
  "description": "REST API for the University Teaching & Learning Management SaaS (staff, courses, rooms, timetables, attendance).",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "pages": "node scripts/build-public-pages.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.1"
  }
}
